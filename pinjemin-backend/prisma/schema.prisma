// ═══════════════════════════════════════════════════════════════════════
// PINJEMIN — Production-Ready Prisma Schema
// PostgreSQL + Prisma ORM | Redesigned for Zero Tech Debt
// ═══════════════════════════════════════════════════════════════════════

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────────────────

/// 11 item categories matching frontend <select> options in item-new.html
enum ItemCategory {
  TOOLS
  ELECTRONICS
  SPORTS
  KITCHEN
  GARDEN
  VEHICLE
  BABY_KIDS
  BOOKS_MEDIA
  FASHION
  OUTDOOR
  OTHER
}

/// 4 item condition levels matching frontend <select> in item-new.html
enum ItemCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_CARE
}

/// 6 request lifecycle statuses matching utils.js getStatusBadge()
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  RETURNED
  OVERDUE
  CANCELLED
}

/// Trust score brackets matching utils.js getTrustLevel()
enum TrustLevel {
  NEW       // score 0–40
  MEMBER    // score 41–70
  TRUSTED   // score 71–89
  VERIFIED  // score 90–100
}

/// User role for access control
enum UserRole {
  USER
  ADMIN
}

/// 9 notification event types matching notifications.html icon map
enum NotificationType {
  BORROW_REQUEST_RECEIVED
  BORROW_REQUEST_APPROVED
  BORROW_REQUEST_REJECTED
  ITEM_RETURNED
  RATING_RECEIVED
  OVERDUE_REMINDER
  TRUST_SCORE_CHANGED
  WELCOME
  SYSTEM
}

// ─── MODELS ─────────────────────────────────────────────────────────────

/// Platform user — lender, borrower, or admin.
/// Registration: nama, username, password (register.html)
/// Edit profile: fullName, bio, address (profile.html modal)
model User {
  id                String         @id @default(uuid()) @map("id")
  username          String         @unique                          /// @unique — login identifier
  fullName          String         @map("full_name")                /// Display name, editable
  email             String?        @unique                          /// Optional — for future email auth
  passwordHash      String?        @map("password_hash")            /// bcrypt hash; null for legacy/seed users
  phone             String?        @unique                          /// Optional — old schema forced it; now nullable
  avatarUrl         String?        @map("avatar_url")               /// Profile picture URL (Cloudinary)
  bio               String?                                         /// Short bio text (profile edit modal)
  address           String?                                         /// Full address — displayed in profile & greeting
  lat               Float?                                          /// Latitude for geolocation
  lng               Float?                                          /// Longitude for geolocation

  // ── Trust & Stats (displayed in profile.html, dashboard.html) ──
  trustScore        Int            @default(40)  @map("trust_score")        /// 0–100, affects trust level
  trustLevel        TrustLevel     @default(NEW) @map("trust_level")        /// Computed from trustScore brackets
  totalLends        Int            @default(0)   @map("total_lends")        /// Counter: items lent out
  totalBorrows      Int            @default(0)   @map("total_borrows")      /// Counter: items borrowed
  successfulReturns Int            @default(0)   @map("successful_returns") /// Counter: on-time returns

  // ── Access Control ──
  role              UserRole       @default(USER)

  // ── Timestamps ──
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt      @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")  /// Soft-delete: set to now() instead of hard delete

  // ── Relations ──
  items             Item[]         @relation("UserItems")
  borrowRequests    Request[]      @relation("BorrowerRequests")
  lendRequests      Request[]      @relation("LenderRequests")
  givenReviews      Review[]       @relation("ReviewAuthor")
  receivedReviews   Review[]       @relation("ReviewTarget")
  notifications     Notification[]

  @@map("users")
}

/// A lendable item listed by a user.
/// Created via 4-step wizard in item-new.html.
/// Displayed in discover.html, dashboard.html, item-detail.html.
model Item {
  id              String        @id @default(uuid()) @map("id")
  title           String                                          /// Item name (max 100 chars in UI)
  description     String                                          /// Free-text description (max 500 chars in UI)
  category        ItemCategory                                    /// Enum-constrained category from dropdown
  condition       ItemCondition                                   /// Enum-constrained condition from dropdown
  images          Json          @default("[]")                    /// JSONB array of base64/URL strings
  depositAmount   BigInt        @default(0) @map("deposit_amount")/// Deposit in IDR; 0 = free to borrow
  isAvailable     Boolean       @default(true) @map("is_available") /// false when actively borrowed
  viewCount       Int           @default(0) @map("view_count")   /// Incremented on detail page view
  neighborhood    String                                          /// Address/location text for display
  lat             Float?                                          /// Latitude
  lng             Float?                                          /// Longitude
  tags            String[]      @default([])                      /// PostgreSQL text array for tag search
  usageGuidelines String?       @map("usage_guidelines")          /// Optional usage instructions

  // ── Owner Relation ──
  ownerId         String        @map("owner_id")
  owner           User          @relation("UserItems", fields: [ownerId], references: [id], onDelete: Cascade)

  // ── Reverse Relations ──
  requests        Request[]
  reviews         Review[]

  // ── Timestamps ──
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt      @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")  /// Soft-delete

  // ── Indexes for common query patterns ──
  @@index([ownerId])                                   /// Profile page: "my items"
  @@index([category, isAvailable, createdAt])           /// Discover: filter + sort
  @@index([category])                                   /// Dashboard category chips
  @@index([createdAt])                                  /// Default sort: newest
  @@map("items")
}

/// A borrow request from borrower → lender for an item.
/// Created via borrow modal in item-detail.html.
/// Managed in requests.html (borrower view) and approvals.html (lender view).
model Request {
  id           String        @id @default(uuid()) @map("id")
  status       RequestStatus @default(PENDING)                /// Lifecycle: PENDING → APPROVED → RETURNED (etc.)
  purpose      String                                         /// Why borrower needs the item (min 10 chars in UI)
  message      String?                                        /// Optional message to owner
  startDate    DateTime      @map("start_date")               /// Borrow start date
  endDate      DateTime      @map("end_date")                 /// Expected return date
  rejectReason String?       @map("reject_reason")            /// Filled when lender rejects

  // ── Item Relation ──
  itemId       String        @map("item_id")
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)

  // ── Borrower Relation ──
  borrowerId   String        @map("borrower_id")
  borrower     User          @relation("BorrowerRequests", fields: [borrowerId], references: [id], onDelete: Cascade)

  // ── Lender Relation ──
  lenderId     String        @map("lender_id")
  lender       User          @relation("LenderRequests", fields: [lenderId], references: [id], onDelete: Cascade)

  // ── Reverse Relation ──
  review       Review?       /// One review per request (1:1 via unique constraint)

  // ── Timestamps ──
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt      @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")  /// Soft-delete

  // ── Indexes ──
  @@index([borrowerId, status])    /// requests.html: "my sent requests" filtered by tab
  @@index([lenderId, status])      /// approvals.html: "requests for my items" filtered by tab
  @@index([itemId])                /// Item detail: related requests
  @@map("requests")
}

/// A rating/review submitted after a borrow is completed.
/// Created via rate-review.html (accessed with ?req=<requestId>).
/// Linked 1:1 to a Request (one review per completed borrow).
model Review {
  id        String   @id @default(uuid()) @map("id")
  rating    Int                                       /// 1–5 star rating for the owner/experience
  itemCond  Int?     @map("item_cond")                /// 1–5 star rating for item condition
  comment   String?                                   /// Optional text review

  // ── Author (reviewer = borrower) ──
  authorId  String?  @map("author_id")
  author    User?    @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  // ── Target (reviewed user = lender) ──
  targetId  String?  @map("target_id")
  target    User?    @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: SetNull)

  // ── Item reviewed ──
  itemId    String?  @map("item_id")
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)

  // ── Request link (NEW — links review to specific borrow transaction) ──
  requestId String?  @unique @map("request_id")       /// @unique ensures one review per request
  request   Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  // ── Timestamps ──
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")
  deletedAt DateTime? @map("deleted_at")  /// Soft-delete

  // ── Indexes ──
  @@index([authorId])              /// "Reviews I've given"
  @@index([targetId])              /// "Reviews about me" (for trust score calculation)
  @@index([itemId])                /// Reviews on an item
  @@map("reviews")
}

/// In-app notification sent to a user.
/// Displayed in notifications.html and dashboard activity feed.
/// Created server-side by request/rating controllers.
model Notification {
  id        String           @id @default(uuid()) @map("id")
  type      NotificationType                        /// Enum-constrained event type
  title     String                                  /// Notification headline
  body      String                                  /// Notification body text
  isRead    Boolean          @default(false) @map("is_read") /// Toggled by "mark all read"
  data      Json?                                   /// Arbitrary payload (e.g. { requestId: "..." })

  // ── User Relation ──
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ── Timestamps ──
  createdAt DateTime         @default(now()) @map("created_at")

  // ── Indexes ──
  @@index([userId, isRead])        /// Notifications page: unread count + filter
  @@index([userId, createdAt])     /// Notifications page: default sort
  @@map("notifications")
}
